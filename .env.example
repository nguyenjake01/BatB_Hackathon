# Copy to .env.local (used by both the Next.js app and contracts/). Never commit real values.

# Mocks: true (default) uses mock data everywhere; false switches every module to its real integration.
USE_MOCKS=true
# Optional per-module overrides, so you can test your own integration while the rest stays mocked:
# USE_MOCKS_SUPPLY=false
# USE_MOCKS_NEGOTIATION=false
# USE_MOCKS_AGENT=false
# USE_MOCKS_PAYMENTS=false
# USE_MOCKS_SQUARE=false

# Person 1 (Jake): Supply (Context.dev web scraping)
CONTEXT_DEV_API_KEY=
# Parallel Context.dev requests (free plan: 1). Set to your plan's concurrency limit.
CONTEXT_DEV_CONCURRENCY=1

# Person 3 (Stanley): Demand (Square Inventory API)
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox

# Person 2 (Jason): Agent
LLM_API_KEY=

# Person 2 (Jason): Payments (AUSD via x402 on Base Sepolia) and audit log (BSC Testnet)
# TESTNET ONLY. Never put a wallet holding real funds here.
AGENT_WALLET_PRIVATE_KEY=
AUSD_CONTRACT_ADDRESS=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
PURCHASE_LOG_CONTRACT_ADDRESS=

# Person 2 (Jason): payout wallet for unclaimed distributors (a Base Sepolia address you control)
DEMO_DISTRIBUTOR_WALLET=

# Shared: HMAC key for signed quotes. Any long random string, same on every machine and on Vercel.
NEGOTIATION_SIGNING_SECRET=
